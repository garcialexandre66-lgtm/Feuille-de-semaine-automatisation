{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asc-feuille-semaine",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/export", "/export/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "asc-semaines",
    "database_id": "5bd020b5-d049-4c3c-a771-668dffab171f",
    "migrations_dir": "cloudflare/migrations"
  }]
}
