{
  "name": "asc-feuille-semaine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node cloudflare/build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "node cloudflare/check-config.mjs && npm run build && wrangler d1 migrations apply asc-semaines --remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply asc-semaines --local",
    "db:remote": "wrangler d1 migrations apply asc-semaines --remote",
    "test": "node --test tests/cloudflare.test.mjs",
    "test:browser": "npm run build && node tests/cloudflare_browser.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "fflate": "0.8.2",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "esbuild": "0.27.4",
    "miniflare": "5.20261023.1-beta",
    "wrangler": "4.154.0"
  }
}
